{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mint Request (handoff from research to execution)",
  "$comment": "Every boolean here is a CLAIM made by the research agent. The executor must re-verify contract, simulation, approvals and signatures independently before sending any transaction. Unknown must be null, never guessed.",
  "type": "object",
  "required": [
    "request_id",
    "requested_at",
    "expires_at",
    "project_name",
    "mint_type",
    "chain",
    "chain_id",
    "contract_address",
    "mint_function",
    "mint_price_native",
    "requires_token_approval",
    "requires_signature",
    "contract_verified",
    "simulation",
    "official_source_urls",
    "opportunity_score",
    "evidence_coverage",
    "execution_readiness",
    "risks",
    "unknowns"
  ],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "requested_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "project_name": { "type": "string", "minLength": 1 },
    "mint_type": { "type": "string", "enum": ["free", "paid"] },
    "chain": { "type": "string", "enum": ["bsc", "ethereum", "base"] },
    "chain_id": { "type": "integer", "enum": [56, 1, 8453] },
    "contract_address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
    "mint_function": { "type": "string", "minLength": 1 },
    "mint_price_native": { "type": "number", "minimum": 0 },
    "estimated_gas_usd": { "type": ["number", "null"], "minimum": 0 },
    "max_supply": { "type": ["integer", "null"], "minimum": 0 },
    "minted_supply": { "type": ["integer", "null"], "minimum": 0 },
    "mint_window": {
      "type": ["object", "null"],
      "properties": {
        "opens_at": { "type": ["string", "null"], "format": "date-time" },
        "closes_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "requires_token_approval": { "type": ["boolean", "null"] },
    "requires_signature": { "type": ["boolean", "null"] },
    "signature_description": { "type": ["string", "null"] },
    "contract_verified": { "type": ["boolean", "null"] },
    "simulation": {
      "type": "object",
      "required": ["performed", "passed"],
      "properties": {
        "performed": { "type": "boolean" },
        "passed": { "type": ["boolean", "null"] },
        "tool": { "type": ["string", "null"] },
        "simulated_at": { "type": ["string", "null"], "format": "date-time" },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "official_source_urls": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "opportunity_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "evidence_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "execution_readiness": {
      "type": "string",
      "enum": ["not_assessed", "blocked", "not_ready", "ready"]
    },
    "user_approval_required": { "type": "boolean" },
    "risks": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "mint_type": { "const": "paid" } } },
      "then": {
        "required": ["user_approval_required"],
        "properties": { "user_approval_required": { "const": true } }
      }
    },
    {
      "if": { "properties": { "mint_type": { "const": "free" } } },
      "then": { "properties": { "mint_price_native": { "const": 0 } } }
    }
  ],
  "additionalProperties": false
}
