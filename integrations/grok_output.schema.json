{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grok Research Output",
  "type": "object",
  "required": [
    "project_name",
    "discovery_source",
    "discovered_at",
    "claims"
  ],
  "properties": {
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "website": {
      "type": [
        "string",
        "null"
      ]
    },
    "x_account": {
      "type": [
        "string",
        "null"
      ]
    },
    "discord_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "chain": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "discovery_source": {
      "type": "string"
    },
    "discovery_query": {
      "type": [
        "string",
        "null"
      ]
    },
    "discovered_at": {
      "type": "string",
      "format": "date-time"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "source",
          "evidence_type"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "evidence_type": {
            "type": "string",
            "enum": [
              "official_announcement",
              "social_signal",
              "wallet_activity",
              "onchain_transaction",
              "market_activity",
              "security_finding",
              "other"
            ]
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "unverified",
              "partially_verified",
              "verified",
              "contradicted"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contract_address": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "mint_function": {
      "type": [
        "string",
        "null"
      ]
    },
    "mint_price_native": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "max_supply": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "mint_window": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "opens_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "closes_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "requires_token_approval": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "requires_signature": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "official_source_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "possible_prompt_injection": {
      "type": "boolean",
      "default": false
    }
  },
  "additionalProperties": false
}
